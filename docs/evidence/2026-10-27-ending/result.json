  "contract": "Keep the saved chapter/paragraph/ratio authoritative while rebuilding the scroll range; extend following content and retry restoration after each render until the offset is reachable within 0.5 CSS pixels or the book ends, without capturing intermediate clamped anchors.",
  "implementation": {
    "file": "apps/windows/src/views/Reader.vue",
    "restoration": "The existing position calculation reports whether its requested offset was reached. fill() reuses chapter additions and retries while restoration is pending.",
    "capture": "Both the scroll handler and anchor capture reject pending restoration; capture also rejects disposed views. Chapter selection supersedes restoration through the existing generation boundary.",
    "hiddenAndEnd": "A zero-height viewport retains the pending anchor until a resize request; no following chapter ends retries at the actual available scroll range.",
    "compatibility": "No dependency, native command, persisted field, storage schema or book-format change."
  },
